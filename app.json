{
  "expo": {
    "name": "MatchMyTrial",
    "slug": "MatchMyTrial",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/MatchMyTrialLogo.png",
    "scheme": "matchmytrial",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.galaxies.MatchMyTrial",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/MatchMyTrialLogo.png",
        "backgroundImage": "./assets/images/MatchMyTrialLogo.png",
        "monochromeImage": "./assets/images/MatchMyTrialLogo.png"
      },
      "package": "com.galaxies.MatchMyTrial",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/MatchMyTrialLogo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-build-properties",
      "@react-native-firebase/app",
      "@react-native-firebase/auth"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6effadba-36a9-4648-ae65-301998b03f63"
      }
    }
  }
}
